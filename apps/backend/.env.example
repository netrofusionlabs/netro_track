PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL="postgresql://<USER>:<PASSWORD>@localhost:5432/<DATABASE>?schema=public"
DIRECT_URL="postgresql://<USER>:<PASSWORD>@localhost:5432/<DATABASE>?schema=public"

# Redis Configuration
REDIS_URL="redis://:<PASSWORD>@localhost:6379"

# Security Secrets
JWT_ACCESS_SECRET="default_access_secret_for_development_purposes_only_32_chars"
JWT_REFRESH_SECRET="default_refresh_secret_for_development_purposes_only_32_chars"

# Logging
LOG_LEVEL=debug

# Cloudflare R2 Storage (File Uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# External APIs
GOOGLE_MAPS_API_KEY=
