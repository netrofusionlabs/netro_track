datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  MANAGER
  FIELD_EMPLOYEE
}

model Company {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  code         String        @unique
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  users        User[]
  branches     Branch[]
  departments  Department[]
  designations Designation[]
  attendances  Attendance[]
  visits       Visit[]
  sales        Sale[]
  inspections  Inspection[]
  gpsLocations GpsLocation[]

  @@map("companies")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  employeeId    String    @map("employee_id")
  name          String
  email         String?   @unique
  passwordHash  String    @map("password_hash")
  mpinHash      String?   @map("mpin_hash")
  role          Role
  managerId     String?   @map("manager_id") @db.Uuid
  branchId      String?   @map("branch_id") @db.Uuid
  departmentId  String?   @map("department_id") @db.Uuid
  designationId String?   @map("designation_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  company          Company      @relation(fields: [companyId], references: [id])
  manager          User?        @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates     User[]       @relation("ManagerSubordinates")
  createdCustomers Customer[]   @relation("CreatedCustomers")
  branch           Branch?      @relation(fields: [branchId], references: [id])
  department       Department?  @relation(fields: [departmentId], references: [id])
  designation      Designation? @relation(fields: [designationId], references: [id])
  devices          Device[]
  sessions         Session[]
  attendances      Attendance[]
  visits           Visit[]
  sales            Sale[]
  inspections      Inspection[]
  gpsLocations     GpsLocation[]

  @@unique([companyId, employeeId])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("userId") @db.Uuid
  refreshToken String   @unique @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("sessions")
}

model Device {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  deviceId     String   @map("device_id")
  os           String
  model        String
  appVersion   String   @map("app_version")
  registeredAt DateTime @default(now()) @map("registered_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, deviceId])
  @@map("devices")
}

model Customer {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  name        String
  phone       String?
  email       String?
  address     String?
  village     String?
  latitude    Decimal?  @db.Decimal(10, 7)
  longitude   Decimal?  @db.Decimal(10, 7)
  type        String?
  createdById String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  createdBy   User?     @relation("CreatedCustomers", fields: [createdById], references: [id])
  visits      Visit[]
  sales       Sale[]

  @@map("customers")
}

model Product {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  name        String
  sku         String?
  description String?
  unit        String?
  price       Decimal?  @db.Decimal(10, 2)
  imageUrl    String?   @map("image_url")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")
  saleItems   SaleItem[]

  @@map("products")
}

model Branch {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String
  address   String?
  latitude  Decimal?  @db.Decimal(10, 7)
  longitude Decimal?  @db.Decimal(10, 7)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company     Company      @relation(fields: [companyId], references: [id])
  departments Department[]
  users       User[]

  @@map("branches")
}

model Department {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  branchId  String?   @map("branch_id") @db.Uuid
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch? @relation(fields: [branchId], references: [id])
  users   User[]

  @@map("departments")
}

model Designation {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id])
  users   User[]

  @@map("designations")
}

model Attendance {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  punchInTime       DateTime  @map("punch_in_time")
  punchInLatitude   Decimal   @map("punch_in_latitude") @db.Decimal(10, 7)
  punchInLongitude  Decimal   @map("punch_in_longitude") @db.Decimal(10, 7)
  punchOutTime      DateTime? @map("punch_out_time")
  punchOutLatitude  Decimal?  @map("punch_out_latitude") @db.Decimal(10, 7)
  punchOutLongitude Decimal?  @map("punch_out_longitude") @db.Decimal(10, 7)
  workingHours      Decimal?  @map("working_hours") @db.Decimal(5, 2)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  gpsLocations GpsLocation[]

  @@map("attendances")
}

model Visit {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  customerId        String    @map("customer_id") @db.Uuid
  checkInTime       DateTime  @map("check_in_time")
  checkOutTime      DateTime? @map("check_out_time")
  duration          Int?
  latitude          Decimal   @db.Decimal(10, 7)
  longitude         Decimal   @db.Decimal(10, 7)
  productsDiscussed String?   @map("products_discussed")
  notes             String?
  imageUrl          String?   @map("image_url")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  company  Company  @relation(fields: [companyId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@map("visits")
}

model Sale {
  id          String     @id @default(uuid()) @db.Uuid
  companyId   String     @map("company_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  customerId  String     @map("customer_id") @db.Uuid
  totalAmount Decimal    @map("total_amount") @db.Decimal(12, 2)
  remarks     String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")
  items       SaleItem[]

  company  Company  @relation(fields: [companyId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@map("sales")
}

model Inspection {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  siteName        String    @map("site_name")
  category        String?
  latitude        Decimal   @db.Decimal(10, 7)
  longitude       Decimal   @db.Decimal(10, 7)
  observation     String
  recommendation  String?
  imageUrls       String[]  @map("image_urls")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("inspections")
}

model SaleItem {
  id         String  @id @default(uuid()) @db.Uuid
  saleId     String  @map("sale_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  quantity   Int
  price      Decimal @db.Decimal(10, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(10, 2)

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

model GpsLocation {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  attendanceId  String?  @map("attendance_id") @db.Uuid
  latitude      Decimal  @db.Decimal(10, 7)
  longitude     Decimal  @db.Decimal(10, 7)
  accuracy      Decimal? @db.Decimal(8, 2)
  speed         Decimal? @db.Decimal(8, 2)
  heading       Decimal? @db.Decimal(6, 2)
  battery       Int?
  networkType   String?  @map("network_type")
  recordedAt    DateTime @map("recorded_at")
  createdAt     DateTime @default(now()) @map("created_at")

  company    Company    @relation(fields: [companyId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
  attendance Attendance? @relation(fields: [attendanceId], references: [id])

  @@index([companyId, userId, recordedAt])
  @@map("gps_locations")
}
