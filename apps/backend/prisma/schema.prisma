datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Role {
  MASTER_SUPER_ADMIN
  SUPER_ADMIN
  COMPANY_ADMIN
  HR
  MANAGER
  EMPLOYEE
}

model Company {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  code         String        @unique
  isGpsEnabled Boolean       @default(true) @map("is_gps_enabled")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  users        User[]
  branches     Branch[]
  departments  Department[]
  designations Designation[]
  attendances  Attendance[]
  visits       Visit[]
  sales        Sale[]
  inspections  Inspection[]
  gpsLocations GpsLocation[]
  timelineEvents UserTimelineEvent[]

  @@map("companies")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  employeeId    String    @map("employee_id")
  name                  String
  email                 String?   @unique
  personalEmail         String?   @map("personal_email")
  phone                 String?   @map("phone")
  secondaryPhone        String?   @map("secondary_phone")
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  linkedinUrl           String?   @map("linkedin_url")
  twitterUrl            String?   @map("twitter_url")
  bloodGroup            String?   @map("blood_group")
  passwordHash          String    @map("password_hash")
  mpinHash              String?   @map("mpin_hash")
  role                  Role
  status                UserStatus @default(ACTIVE)
  isGpsTracked          Boolean    @default(true) @map("is_gps_tracked")
  managerId             String?    @map("manager_id") @db.Uuid
  branchId              String?    @map("branch_id") @db.Uuid
  departmentId          String?    @map("department_id") @db.Uuid
  designationId         String?    @map("designation_id") @db.Uuid
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")
  deletedAt             DateTime?  @map("deleted_at")

  company          Company      @relation(fields: [companyId], references: [id])
  manager          User?        @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates     User[]       @relation("ManagerSubordinates")
  createdCustomers Customer[]   @relation("CreatedCustomers")
  branch           Branch?      @relation(fields: [branchId], references: [id])
  department       Department?  @relation(fields: [departmentId], references: [id])
  designation      Designation? @relation(fields: [designationId], references: [id])
  devices          Device[]
  sessions         Session[]
  attendances      Attendance[]
  visits           Visit[]
  sales            Sale[]
  inspections         Inspection[]
  gpsLocations        GpsLocation[]
  timelineEvents      UserTimelineEvent[] @relation("UserTimelineEvents")
  actedTimelineEvents UserTimelineEvent[] @relation("ActorTimelineEvents")

  @@unique([companyId, employeeId])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("userId") @db.Uuid
  refreshToken String   @unique @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("sessions")
}

model Device {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  deviceId     String   @map("device_id")
  os           String
  model        String
  appVersion   String   @map("app_version")
  registeredAt DateTime @default(now()) @map("registered_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, deviceId])
  @@map("devices")
}

model Customer {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  name        String
  phone       String?
  email       String?
  address     String?
  village     String?
  latitude    Decimal?  @db.Decimal(10, 7)
  longitude   Decimal?  @db.Decimal(10, 7)
  type        String?
  createdById String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  createdBy   User?     @relation("CreatedCustomers", fields: [createdById], references: [id])
  visits      Visit[]
  sales       Sale[]

  @@map("customers")
}

model Product {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  name        String
  sku         String?
  description String?
  unit        String?
  price       Decimal?  @db.Decimal(10, 2)
  imageUrl    String?   @map("image_url")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")
  saleItems   SaleItem[]

  @@map("products")
}

model Branch {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String
  address   String?
  latitude  Decimal?  @db.Decimal(10, 7)
  longitude Decimal?  @db.Decimal(10, 7)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company     Company      @relation(fields: [companyId], references: [id])
  departments Department[]
  users       User[]

  @@map("branches")
}

model Department {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  branchId  String?   @map("branch_id") @db.Uuid
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch? @relation(fields: [branchId], references: [id])
  users   User[]

  @@map("departments")
}

model Designation {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id])
  users   User[]

  @@map("designations")
}

model Attendance {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  punchInTime       DateTime  @map("punch_in_time")
  punchInLatitude   Decimal   @map("punch_in_latitude") @db.Decimal(10, 7)
  punchInLongitude  Decimal   @map("punch_in_longitude") @db.Decimal(10, 7)
  punchOutTime      DateTime? @map("punch_out_time")
  punchOutLatitude  Decimal?  @map("punch_out_latitude") @db.Decimal(10, 7)
  punchOutLongitude Decimal?  @map("punch_out_longitude") @db.Decimal(10, 7)
  workingHours      Decimal?  @map("working_hours") @db.Decimal(5, 2)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  gpsLocations GpsLocation[]

  @@map("attendances")
}

model Visit {
  id                String    @id @default(uuid()) @db.Uuid
  /// Client-generated UUID for offline idempotency (BR-SY03)
  localId           String?   @unique @map("local_id")
  companyId         String    @map("company_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  customerId        String    @map("customer_id") @db.Uuid
  checkInTime       DateTime  @map("check_in_time")
  checkOutTime      DateTime? @map("check_out_time")
  duration          Int?
  latitude          Decimal   @db.Decimal(10, 7)
  longitude         Decimal   @db.Decimal(10, 7)
  productsDiscussed String?   @map("products_discussed")
  notes             String?
  imageUrl          String?   @map("image_url")
  photoUrls         String[]  @default([]) @map("photo_urls")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  company  Company  @relation(fields: [companyId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([companyId, userId, checkInTime])
  @@map("visits")
}

model Sale {
  id          String     @id @default(uuid()) @db.Uuid
  /// Client-generated UUID for offline idempotency (BR-SY03)
  localId     String?    @unique @map("local_id")
  companyId   String     @map("company_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  customerId  String     @map("customer_id") @db.Uuid
  totalAmount Decimal    @map("total_amount") @db.Decimal(12, 2)
  remarks     String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")
  items       SaleItem[]

  company  Company  @relation(fields: [companyId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([companyId, userId, createdAt])
  @@map("sales")
}

model Inspection {
  id              String    @id @default(uuid()) @db.Uuid
  /// Client-generated UUID for offline idempotency (BR-SY03)
  localId         String?   @unique @map("local_id")
  companyId       String    @map("company_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  siteName        String    @map("site_name")
  category        String?
  latitude        Decimal   @db.Decimal(10, 7)
  longitude       Decimal   @db.Decimal(10, 7)
  observation     String
  recommendation  String?
  imageUrls       String[]  @default([]) @map("image_urls")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId, userId, createdAt])
  @@map("inspections")
}

model SaleItem {
  id         String  @id @default(uuid()) @db.Uuid
  saleId     String  @map("sale_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  quantity   Int
  price      Decimal @db.Decimal(10, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(10, 2)

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

model GpsLocation {
  id              String   @id @default(uuid()) @db.Uuid
  /// Client-generated UUID for idempotent batch sync (BR-SY03, BR-G11)
  localId         String?  @unique @map("local_id")
  companyId       String   @map("company_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  attendanceId    String?  @map("attendance_id") @db.Uuid
  latitude        Decimal  @db.Decimal(10, 7)
  longitude       Decimal  @db.Decimal(10, 7)
  accuracy        Decimal? @db.Decimal(8, 2)
  speed           Decimal? @db.Decimal(8, 2)
  heading         Decimal? @db.Decimal(6, 2)
  altitude        Decimal? @db.Decimal(10, 2)
  batteryLevel    Int?     @map("battery_level")
  batteryCharging Boolean? @map("battery_charging")
  networkType     String?  @map("network_type")
  gpsProvider     String?  @map("gps_provider")
  /// True when accuracy is within 100 m threshold (BR-G08)
  isAccurate      Boolean? @map("is_accurate")
  recordedAt      DateTime @map("recorded_at")
  createdAt       DateTime @default(now()) @map("created_at")

  company    Company     @relation(fields: [companyId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
  attendance Attendance? @relation(fields: [attendanceId], references: [id])

  @@index([companyId, userId, recordedAt])
  @@index([companyId, userId])
  @@map("gps_locations")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

enum TimelineEventType {
  ONBOARDING
  DESIGNATION_ASSIGNED
  DESIGNATION_CHANGED
  PROMOTION
  ACCESS_ROLE_ASSIGNED
  ACCESS_ROLE_CHANGED
  MANAGER_ASSIGNED
  MANAGER_CHANGED
  EMPLOYMENT_TYPE_CHANGED
  LOCATION_CHANGED
  DEPARTMENT_CHANGED
  COMPANY_CHANGED
}

model UserTimelineEvent {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  eventType       TimelineEventType @map("event_type")
  title           String
  description     String?
  previousValue   String?           @map("previous_value")
  newValue        String?           @map("new_value")
  changedByUserId String?           @map("changed_by_user_id") @db.Uuid
  changedByName   String?           @map("changed_by_name")
  effectiveDate   DateTime          @default(now()) @map("effective_date")
  createdAt       DateTime          @default(now()) @map("created_at")

  user      User    @relation("UserTimelineEvents", fields: [userId], references: [id], onDelete: Cascade)
  changedBy User?   @relation("ActorTimelineEvents", fields: [changedByUserId], references: [id], onDelete: SetNull)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([userId, effectiveDate])
  @@map("user_timeline_events")
}
